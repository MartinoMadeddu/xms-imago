{
  "name": "karma",
  "label": "Karma",
  "namespace": "karma:global",
  "about": "SideFX Karma (CPU and XPU), through husk or Houdini. Settings are namespaced attributes on the RenderSettings prim. Names marked unconfirmed follow Houdini's Karma Render Settings but were not checked against `karma --all-properties`. AOVs follow what Houdini 20.5's Karma Render Settings writes (each RenderVar's format, filter, multi-sampling); those marked unconfirmed were not seen in a Houdini file.",
  "params": [
    {"name": "karma:global:samplesperpixel", "type": "int", "default": 9, "min": 1, "max": 1024, "group": "Sampling", "label": "Pixel Samples", "unconfirmed": true, "help": "Camera rays per pixel: anti-aliasing, motion blur and depth of field."},
    {"name": "karma:global:pathtracedsamples", "type": "int", "default": 1, "min": 1, "max": 256, "group": "Sampling", "label": "Path Traced Samples", "unconfirmed": true, "help": "Secondary rays for each camera ray, with Convergence Mode set to Path Traced."},
    {"name": "karma:global:convergencemode", "type": "token", "default": "variance", "choices": ["variance", "automatic", "pathtraced", "distributed"], "group": "Sampling", "label": "Convergence Mode", "unconfirmed": true, "help": "How Karma decides where to spend samples."},
    {"name": "karma:global:diffuselimit", "type": "int", "default": 1, "min": 0, "max": 64, "group": "Limits", "label": "Diffuse Limit", "unconfirmed": true, "help": "How many times a path may bounce off diffuse surfaces."},
    {"name": "karma:global:reflectlimit", "type": "int", "default": 4, "min": 0, "max": 64, "group": "Limits", "label": "Reflection Limit", "unconfirmed": true, "help": "How many times a path may reflect off glossy surfaces."},
    {"name": "karma:global:refractlimit", "type": "int", "default": 4, "min": 0, "max": 64, "group": "Limits", "label": "Refraction Limit", "unconfirmed": true, "help": "How many times a path may refract."},
    {"name": "karma:global:volumelimit", "type": "int", "default": 0, "min": 0, "max": 64, "group": "Limits", "label": "Volume Limit", "unconfirmed": true, "help": "How many times a path may scatter in a volume."},
    {"name": "karma:global:ssslimit", "type": "int", "default": 0, "min": 0, "max": 64, "group": "Limits", "label": "SSS Limit", "unconfirmed": true, "help": "How many subsurface scattering bounces a path may take."},
    {"name": "karma:global:colorlimit", "type": "float", "default": 10.0, "min": 0.0, "max": 1000.0, "group": "Limits", "label": "Color Limit", "unconfirmed": true, "help": "The brightest a sample may be: clamps fireflies from indirect light."},
    {"name": "karma:global:bucketsize", "type": "int", "default": 32, "min": 4, "max": 512, "group": "Image", "label": "Bucket Size", "unconfirmed": true, "help": "Width and height of the tiles the image is rendered in, in pixels."},
    {"name": "karma:global:cacheratio", "type": "float", "default": 0.25, "min": 0.0, "max": 1.0, "group": "Performance", "label": "Cache Ratio", "help": "The share of physical memory the unified cache may use."},
    {"name": "karma:object:geosamples", "type": "int", "default": 1, "min": 1, "max": 16, "group": "Motion", "label": "Geometry Time Samples", "help": "Deformation blur samples. Written on the RenderSettings prim as the default for every object."},
    {"name": "karma:object:dicingquality", "type": "float", "default": 1.0, "min": 0.0, "max": 10.0, "group": "Geometry", "label": "Dicing Quality", "help": "How finely subdivision and displaced surfaces are diced: shading scales with its square."}
  ],
  "aovs": [
    {"name": "C", "sourceName": "C.*[LO]", "sourceType": "lpe", "dataType": "color4f", "group": "Beauty", "label": "Beauty", "format": "color4h", "multiSampled": true, "default": true},
    {"name": "beautyunshadowed", "sourceName": "beautyunshadowed", "sourceType": "raw", "dataType": "color3f", "group": "Beauty", "label": "Beauty Unshadowed", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "combineddiffuse", "sourceName": "C<RD>.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Combined Diffuse", "format": "color3h", "multiSampled": true},
    {"name": "directdiffuse", "sourceName": "C<RD>L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Direct Diffuse", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "indirectdiffuse", "sourceName": "C<RD>.+L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Indirect Diffuse", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "combinedglossyreflection", "sourceName": "C<RG>.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Combined Glossy Reflection", "format": "color3h", "multiSampled": true},
    {"name": "directglossyreflection", "sourceName": "C<RG>L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Direct Glossy Reflection", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "indirectglossyreflection", "sourceName": "C<RG>.+L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Indirect Glossy Reflection", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "glossytransmission", "sourceName": "C<TG>.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Glossy Transmission", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "coat", "sourceName": "C<RG'coat'>.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Coat", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "combinedemission", "sourceName": "C.*O", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Combined Emission", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "directemission", "sourceName": "CO", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Direct Emission", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "indirectemission", "sourceName": "C.+O", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Indirect Emission", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "visiblelights", "sourceName": "CL", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Visible Lights", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "combinedvolume", "sourceName": "CV.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Combined Volume", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "directvolume", "sourceName": "CVL", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Direct Volume", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "indirectvolume", "sourceName": "CV.+L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Indirect Volume", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "sss", "sourceName": "C<TD>.*L", "sourceType": "lpe", "dataType": "color3f", "group": "Light paths", "label": "Subsurface Scattering", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "albedo", "sourceName": "export_basecolor", "sourceType": "raw", "dataType": "color3f", "group": "Surface", "label": "Albedo (base colour)", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "AO", "sourceName": "AO", "sourceType": "raw", "dataType": "color3f", "group": "Surface", "label": "Ambient Occlusion", "format": "color3h", "multiSampled": true, "unconfirmed": true},
    {"name": "P", "sourceName": "ray:hitP", "sourceType": "raw", "dataType": "point3f", "group": "Utility", "label": "P (World Space)", "format": "float3", "multiSampled": false},
    {"name": "P_camera", "sourceName": "ray:hitP_camera", "sourceType": "raw", "dataType": "point3f", "group": "Utility", "label": "P (Camera Space)", "format": "float3", "multiSampled": false},
    {"name": "depth", "sourceName": "ray:hitPz", "sourceType": "raw", "dataType": "float", "group": "Utility", "label": "Depth (Camera Space)", "format": "float", "multiSampled": false, "unconfirmed": true},
    {"name": "UV", "sourceName": "st", "sourceType": "primvar", "dataType": "float3", "group": "Utility", "label": "Texture Coordinates (st)", "format": "float3", "multiSampled": false},
    {"name": "N", "sourceName": "ray:hitN", "sourceType": "raw", "dataType": "normal3f", "group": "Utility", "label": "N (Smooth Normal)", "format": "float3", "multiSampled": false, "unconfirmed": true},
    {"name": "Ng", "sourceName": "ray:hitNg", "sourceType": "raw", "dataType": "normal3f", "group": "Utility", "label": "Ng (Geometric Normal)", "format": "float3", "multiSampled": false, "unconfirmed": true},
    {"name": "motionvector", "sourceName": "motionvector", "sourceType": "raw", "dataType": "vector3f", "group": "Utility", "label": "Motion Vector", "format": "float3", "multiSampled": false, "unconfirmed": true},
    {"name": "element", "sourceName": "ray:element", "sourceType": "raw", "dataType": "float", "group": "IDs", "label": "Element (prim)", "format": "float", "multiSampled": false, "unconfirmed": true},
    {"name": "primid", "sourceName": "ray:primid", "sourceType": "raw", "dataType": "float", "group": "IDs", "label": "Primitive ID", "format": "float", "multiSampled": false, "unconfirmed": true}
  ],
  "var_defaults": [
    {"name": "driver:parameters:aov:clearValue", "type": "int", "default": 0},
    {"name": "driver:parameters:aov:karma:filter", "type": "string", "default": "[\"ubox\",{}]"}
  ]
}
