{
  "name": "karma",
  "label": "Karma",
  "namespace": "karma:global",
  "about": "SideFX Karma (CPU and XPU), through husk or Houdini. Settings are namespaced attributes on the RenderSettings prim. Names marked unconfirmed follow Houdini's Karma Render Settings but were not checked against `karma --all-properties`.",
  "params": [
    { "name": "karma:global:samplesperpixel", "type": "int", "default": 9, "min": 1, "max": 1024,
      "group": "Sampling", "label": "Pixel Samples", "unconfirmed": true,
      "help": "Camera rays per pixel: anti-aliasing, motion blur and depth of field." },
    { "name": "karma:global:pathtracedsamples", "type": "int", "default": 1, "min": 1, "max": 256,
      "group": "Sampling", "label": "Path Traced Samples", "unconfirmed": true,
      "help": "Secondary rays for each camera ray, with Convergence Mode set to Path Traced." },
    { "name": "karma:global:convergencemode", "type": "token", "default": "variance",
      "choices": ["variance", "automatic", "pathtraced", "distributed"],
      "group": "Sampling", "label": "Convergence Mode", "unconfirmed": true,
      "help": "How Karma decides where to spend samples." },
    { "name": "karma:global:diffuselimit", "type": "int", "default": 1, "min": 0, "max": 64,
      "group": "Limits", "label": "Diffuse Limit", "unconfirmed": true,
      "help": "How many times a path may bounce off diffuse surfaces." },
    { "name": "karma:global:reflectlimit", "type": "int", "default": 4, "min": 0, "max": 64,
      "group": "Limits", "label": "Reflection Limit", "unconfirmed": true,
      "help": "How many times a path may reflect off glossy surfaces." },
    { "name": "karma:global:refractlimit", "type": "int", "default": 4, "min": 0, "max": 64,
      "group": "Limits", "label": "Refraction Limit", "unconfirmed": true,
      "help": "How many times a path may refract." },
    { "name": "karma:global:volumelimit", "type": "int", "default": 0, "min": 0, "max": 64,
      "group": "Limits", "label": "Volume Limit", "unconfirmed": true,
      "help": "How many times a path may scatter in a volume." },
    { "name": "karma:global:ssslimit", "type": "int", "default": 0, "min": 0, "max": 64,
      "group": "Limits", "label": "SSS Limit", "unconfirmed": true,
      "help": "How many subsurface scattering bounces a path may take." },
    { "name": "karma:global:colorlimit", "type": "float", "default": 10.0, "min": 0.0, "max": 1000.0,
      "group": "Limits", "label": "Color Limit", "unconfirmed": true,
      "help": "The brightest a sample may be: clamps fireflies from indirect light." },
    { "name": "karma:global:bucketsize", "type": "int", "default": 32, "min": 4, "max": 512,
      "group": "Image", "label": "Bucket Size", "unconfirmed": true,
      "help": "Width and height of the tiles the image is rendered in, in pixels." },
    { "name": "karma:global:cacheratio", "type": "float", "default": 0.25, "min": 0.0, "max": 1.0,
      "group": "Performance", "label": "Cache Ratio",
      "help": "The share of physical memory the unified cache may use." },
    { "name": "karma:object:geosamples", "type": "int", "default": 1, "min": 1, "max": 16,
      "group": "Motion", "label": "Geometry Time Samples",
      "help": "Deformation blur samples. Written on the RenderSettings prim as the default for every object." },
    { "name": "karma:object:dicingquality", "type": "float", "default": 1.0, "min": 0.0, "max": 10.0,
      "group": "Geometry", "label": "Dicing Quality",
      "help": "How finely subdivision and displaced surfaces are diced: shading scales with its square." }
  ],
  "aovs": [
